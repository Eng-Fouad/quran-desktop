{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Quran",
        "width": 1440,
        "height": 940,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/tray/tray-32.png",
      "icons/tray/tray-16.png",
      "icons/tray/tray-24.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libasound2 | libasound2t64"]
      }
    }
  }
}
