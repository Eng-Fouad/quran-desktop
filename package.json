{
  "name": "quran-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Quran for Desktop: a beautiful, offline-first Quran reader with recitation",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode mock",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:css": "node scripts/check-logical-css.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "bindings": "cargo test -p quran-desktop --lib export_bindings",
    "bindings:check": "node scripts/check-bindings.mjs",
    "core:qdc": "cargo xtask build-core --source qdc",
    "core:qul": "cargo xtask build-core --source qul",
    "core:release": "cargo xtask build-core --source qdc --for-release --out data/core/core.db",
    "core:verify": "cargo xtask verify-core",
    "fixtures": "cargo xtask export-fixtures",
    "dev-packs": "cargo xtask fetch-dev-packs",
    "assets": "cargo xtask fetch-assets",
    "shots:web": "node scripts/qa/web-shot.mjs --serve 1520 --registry tests/e2e/scenarios",
    "shots:app": "node scripts/qa/app-driver.mjs --registry tests/e2e/scenarios",
    "check:dist": "node scripts/check-dist.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "check:ci": "node .github/actions/policy/policy.mjs",
    "brand": "node assets/brand/tools/build.mjs",
    "brand:check": "node assets/brand/tools/build.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.54.0",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-log": "2.10.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-os": "2.4.0",
    "bits-ui": "2.19.5",
    "dompurify": "3.4.16",
    "paneforge": "1.0.2",
    "svelte": "5.57.2",
    "svelte-sonner": "1.2.1",
    "virtua": "0.53.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.0",
    "playwright-core": "1.64.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vitest-browser-svelte": "3.1.0"
  }
}
