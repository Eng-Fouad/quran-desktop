<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.quran.labs.desktop.home.ui.ActionBarFxController" alignment="CENTER">
    <padding>
        <Insets topRightBottomLeft="10.0"/>
    </padding>
    <HBox spacing="5.0" alignment="CENTER">
        <MenuButton fx:id="mbLanguage">
            <graphic>
                <FontIcon iconLiteral="ci-earth-filled" iconSize="14"/>
            </graphic>
        </MenuButton>
        <Separator orientation="VERTICAL">
            <padding>
                <Insets left="5.0" right="2.0"/>
            </padding>
        </Separator>
        <Button fx:id="btnSearch">
            <graphic>
                <FontIcon iconLiteral="ci-search" iconSize="14"/>
            </graphic>
        </Button>
        <Button fx:id="btnSettings">
            <graphic>
                <FontIcon iconLiteral="ci-settings" iconSize="14"/>
            </graphic>
        </Button>
    </HBox>
</VBox>