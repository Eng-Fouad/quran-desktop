<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.quran.labs.desktop.controllers.RecitationPanelFxController">
    <VBox fx:id="paneIdle" spacing="5.0">
        <GridPane hgap="5.0" vgap="5.0">
            <columnConstraints>
                <ColumnConstraints/>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints/>
                <ColumnConstraints/>
            </columnConstraints>
            <Label fx:id="lblFromChapter" text="%label.fromChapter" GridPane.rowIndex="0" GridPane.columnIndex="0" minWidth="-Infinity"/>
            <ComboBox fx:id="cbFromChapter" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.fillWidth="true" maxWidth="Infinity"/>
            <Label fx:id="lblFromAyah" text="%label.ayah" GridPane.rowIndex="0" GridPane.columnIndex="2" minWidth="-Infinity"/>
            <ComboBox fx:id="cbFromAyah" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
            <Label fx:id="lblToChapter" text="%label.toChapter" GridPane.rowIndex="1" GridPane.columnIndex="0" minWidth="-Infinity"/>
            <ComboBox fx:id="cbToChapter" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.fillWidth="true" maxWidth="Infinity"/>
            <Label fx:id="lblToAyah" text="%label.ayah" GridPane.rowIndex="1" GridPane.columnIndex="2" minWidth="-Infinity"/>
            <ComboBox fx:id="cbToAyah" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
            <MenuButton GridPane.rowIndex="1" GridPane.columnIndex="4">
                <graphic>
                    <FontIcon iconLiteral="ci-settings-adjust" iconSize="14"/>
                </graphic>
                <items>
                    <MenuItem text="%label.toPageEnd"/>
                    <MenuItem text="%label.toJuzEnd"/>
                    <MenuItem text="%label.toHizbEnd"/>
                </items>
            </MenuButton>
        </GridPane>
        <GridPane hgap="5.0">
            <columnConstraints>
                <ColumnConstraints/>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints/>
                <ColumnConstraints/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label fx:id="lblRecitationRepetition" text="%label.recitationRepetition" GridPane.rowIndex="0" GridPane.columnIndex="0" minWidth="-Infinity"/>
            <ComboBox fx:id="cbRecitationRepetition" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.fillWidth="true" maxWidth="Infinity"/>
            <Separator orientation="VERTICAL" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <Label fx:id="lblEachAyahRepetition" text="%label.eachAyahRepetition" GridPane.rowIndex="0" GridPane.columnIndex="3" minWidth="-Infinity"/>
            <ComboBox fx:id="cbEachAyahRepetition" GridPane.rowIndex="0" GridPane.columnIndex="4" GridPane.fillWidth="true" maxWidth="Infinity"/>
        </GridPane>
        <HBox spacing="5.0" alignment="CENTER">
            <Label fx:id="lblReciter" text="%label.reciter" minWidth="-Infinity"/>
            <ComboBox fx:id="cbReciter" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="btnPlaySelectedReciter">
                <graphic>
                    <FontIcon iconLiteral="ci-play-filled-alt" iconSize="14"/>
                </graphic>
            </Button>
        </HBox>
    </VBox>
    <VBox fx:id="paneDownloading" visible="false" managed="false">

    </VBox>
    <VBox fx:id="panePlaying" visible="false" managed="false">
        <HBox spacing="5.0" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT">
            <Button fx:id="btnBackward">
                <graphic>
                    <FontIcon iconLiteral="ci-skip-back-filled" iconSize="14"/>
                </graphic>
            </Button>

            <Button fx:id="btnForward">
                <graphic>
                    <FontIcon iconLiteral="ci-skip-forward-filled" iconSize="14"/>
                </graphic>
            </Button>
        </HBox>
    </VBox>
</StackPane>