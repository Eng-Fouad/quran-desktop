<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.Scene?>
<?import javafx.stage.Stage?>
<Stage fx:id="primaryStage" xmlns:fx="http://javafx.com/fxml" fx:controller="com.quran.labs.desktop.controllers.MainFxController"
       width="1024.0" height="728.0" onCloseRequest="#onClosingStage">
    <fx:define>
        <fx:include source="/views/dialogs/message-dialog.fxml"/>
        <fx:include source="/views/dialogs/http-error-dialog.fxml"/>
        <fx:include source="/views/dialogs/stacktrace-dialog.fxml"/>
    </fx:define>
    <icons>
        <Image url="@/images/ic_launcher.png"/>
    </icons>
    <scene>
        <Scene fx:id="primaryScene" stylesheets="@/styles/main.css">
            <BorderPane styleClass="root-pane">
                <center>
                    <StackPane>
                        <StackPane fx:id="loadingPane">
                            <fx:include source="/views/main/loading.fxml"/>
                        </StackPane>
                        <StackPane fx:id="homePane" managed="false" visible="false">
                            <fx:include source="/views/main/home.fxml"/>
                        </StackPane>
                    </StackPane>
                </center>
            </BorderPane>
        </Scene>
    </scene>
</Stage>