<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.quran.labs.desktop.controllers.LoadingFxController">
    <center>
        <HBox alignment="CENTER">
            <VBox alignment="CENTER" spacing="10.0">
                <VBox VBox.vgrow="ALWAYS" alignment="CENTER">
                    <ImageView>
                        <Image url="@/images/ic_launcher.png"/>
                    </ImageView>
                    <StackPane alignment="TOP_CENTER">
                        <VBox fx:id="paneProgressIndicator" spacing="5.0" alignment="TOP_CENTER">
                            <ProgressIndicator maxHeight="25.0" maxWidth="25.0" styleClass="blue-progress"/>
                            <Label fx:id="lblProgressIndicator"/>
                        </VBox>
                        <VBox fx:id="paneProgressBar" spacing="5.0" alignment="TOP_CENTER" visible="false">
                            <ProgressBar fx:id="pbLoading" progress="0.0" prefWidth="300.0"/>
                            <Label fx:id="lblProgressBar"/>
                        </VBox>
                        <VBox fx:id="paneDownloadButton" spacing="5.0" alignment="TOP_CENTER" visible="false">
                            <Label text="%label.someFilesMustBeDownloaded"/>
                            <Button text="%button.downloadFiles" onAction="#onDownloadFilesButtonClicked"/>
                        </VBox>
                        <HBox fx:id="paneError" spacing="5.0" alignment="CENTER" visible="false">
                            <Label fx:id="lblError"/>
                            <Button fx:id="btnRetry" text="%button.retry" onAction="#onRetryButtonClicked"/>
                            <Button fx:id="btnShowErrorDetails" text="%button.showErrorDetails"/>
                        </HBox>
                    </StackPane>
                </VBox>
                <MenuButton fx:id="mbLanguage">
                    <VBox.margin>
                        <Insets bottom="50.0"/>
                    </VBox.margin>
                    <graphic>
                        <FontIcon iconLiteral="ci-earth-filled" iconSize="14"/>
                    </graphic>
                </MenuButton>
            </VBox>
        </HBox>
    </center>
</BorderPane>