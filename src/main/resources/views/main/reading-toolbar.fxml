<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import org.controlsfx.control.SegmentedButton?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.quran.labs.desktop.controllers.ReadingToolbarFxController"
      spacing="5.0" alignment="CENTER">
    <padding>
        <Insets topRightBottomLeft="9.0"/>
    </padding>
    <SegmentedButton fx:id="sbReadingLayout">
        <buttons>
            <ToggleButton fx:id="tbZoomedSinglePage">
                <graphic>
                    <FontIcon iconLiteral="ci-zoom-in" iconSize="14"/>
                </graphic>
            </ToggleButton>
            <ToggleButton fx:id="tbFullSinglePage" selected="true">
                <graphic>
                    <FontIcon iconLiteral="ci-notebook" iconSize="14"/>
                </graphic>
            </ToggleButton>
            <ToggleButton fx:id="tbFullDoublePage">
                <graphic>
                    <FontIcon iconLiteral="ci-book" iconSize="14"/>
                </graphic>
            </ToggleButton>
        </buttons>
    </SegmentedButton>
    <Separator orientation="VERTICAL"/>
    <Label fx:id="lblPart" text="%label.part" labelFor="$txtPart" minWidth="-Infinity"/>
    <TextField fx:id="txtPart" prefWidth="30.0" editable="false" minWidth="-Infinity"/>
    <Separator orientation="VERTICAL"/>
    <Label fx:id="lblChapter" text="%label.chapter" labelFor="$txtChapter" minWidth="-Infinity"/>
    <TextField fx:id="txtChapter" prefWidth="70.0" editable="false" minWidth="-Infinity"/>
    <Separator orientation="VERTICAL"/>
    <Label fx:id="lblPage" text="%label.page" labelFor="$txtPage" minWidth="-Infinity"/>
    <TextField fx:id="txtPage" prefWidth="30.0" editable="false" minWidth="-Infinity"/>
    <Slider fx:id="sPage" min="1" max="604" blockIncrement="1.0" majorTickUnit="1.0" minorTickCount="0" snapToTicks="true" minWidth="0" HBox.hgrow="ALWAYS"/>
</HBox>